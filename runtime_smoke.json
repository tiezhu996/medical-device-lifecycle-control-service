{
  "mode": "service",
  "start": "go run ./cmd/server",
  "workdir": "backend",
  "env": {
    "SERVER_PORT": "18086",
    "DATABASE_DRIVER": "sqlite",
    "DATABASE_DSN": "file:runtime-smoke?mode=memory&cache=shared",
    "REDIS_ADDR": "127.0.0.1:1",
    "JWT_SECRET": "runtime-smoke-secret"
  },
  "ready_url": "http://127.0.0.1:18086/healthz",
  "ready_status": [200],
  "startup_timeout": 30
}
